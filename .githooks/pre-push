#!/bin/sh
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File scripts/check-secrets.ps1 -All
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-secrets.ps1 -All
else
    echo "pre-push: PowerShell non trovato; scan segreti non eseguito" >&2
    exit 1
fi

cargo clippy --workspace --all-targets -j 1 -- -D warnings
cargo test --workspace -j 1
