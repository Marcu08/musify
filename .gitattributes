# Normalize line endings in the repository.
* text=auto

# Source and documentation use LF.
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.sh text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.flac binary
*.wav binary
*.ogg binary
*.m4a binary
*.mp4 binary
*.sqlite3 binary
*.sqlite3-wal binary
*.sqlite3-shm binary
*.db binary
*.exe binary
*.dll binary
*.pdb binary
